# Copy to .env.local and fill in there. Never put real values in this file: git tracks it.

AI_PROVIDER=gemini            # gemini | anthropic
GEMINI_API_KEY=
GEMINI_MODEL_SMART=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=
CLAUDE_MODEL_SMART=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

DATABASE_URL=                 # Supabase Postgres connection string
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

EMBEDDING_PROVIDER=mock       # voyage | mock
VOYAGE_API_KEY=

DEMO_MODE=false               # true serves saved sample answers and needs no AI key
