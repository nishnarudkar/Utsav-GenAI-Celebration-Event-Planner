{
  "name": "utsav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ],
    "overrides": {
      "postcss": "^8.5.23"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:check": "tsx --env-file=.env.local --conditions=react-server scripts/check-db.ts",
    "fixtures:rituals": "tsx scripts/gen-ritual-fixtures.ts",
    "ai:check": "tsx --env-file=.env.local --conditions=react-server scripts/check-ai.ts",
    "format": "prettier --write src scripts tests/unit tests/e2e",
    "format:check": "prettier --check src scripts tests/unit tests/e2e",
    "samples:quote": "tsx scripts/gen-sample-quote.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "next": "^15.5.28",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
